{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "content/agents/**"
    }
  },
  "rewrites": [
    { "source": "/api/translate", "destination": "/api/ops/translate" },
    { "source": "/api/proxy", "destination": "/api/ops/proxy" },
    { "source": "/api/usage/log", "destination": "/api/ops/usage-log" },
    { "source": "/api/weather/forecast", "destination": "/api/ops/weather-forecast" },
    { "source": "/api/health/integrations", "destination": "/api/ops/health-integrations" },
    { "source": "/api/events", "destination": "/api/ops/events" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/)(?!.*\\.).*)", "destination": "/index.html" }
  ]
}
