{
  "name": "futura-nota",
  "version": "0.6.0",
  "private": true,
  "description": "Futura Nota",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- vite",
    "dev:tina": "dotenv -e .env.local -- tinacms dev -c \"vite\"",
    "build": "node scripts/tinacms-build.mjs && vite build",
    "build:full": "npm run build",
    "build:tina": "dotenv -e .env.local -- tinacms build",
    "preview": "vite preview",
    "start": "npm run dev",
    "verify:apis": "dotenv -e .env.local -- node scripts/verify-integrations.mjs",
    "verify:apis:config": "dotenv -e .env.local -- node scripts/verify-integrations.mjs --config-only",
    "seed:management": "dotenv -e .env.local -- node scripts/seed-management-futuranota.mjs",
    "reset:credits": "dotenv -e .env.local -- node scripts/reset-admin-credits.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tavily/core": "^0.7.6",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "html-to-text": "^10.0.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.16.0",
    "stripe": "^22.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/cli": "^2.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.0",
    "tinacms": "^3.9.0",
    "vite": "^6.0.3"
  }
}
