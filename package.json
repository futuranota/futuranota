{
  "name": "futura-nota",
  "version": "0.6.0",
  "private": true,
  "description": "Futura Nota — Voltway Arc",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- tinacms dev -c \"vite\"",
    "build": "tinacms build --local --skip-cloud-checks && vite build",
    "build:tina": "dotenv -e .env.local -- tinacms build",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/cli": "^2.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.0",
    "tinacms": "^3.9.0",
    "vite": "^6.0.3"
  }
}
