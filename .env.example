# Launch radar (dev server: POST /api/analytics/brand-cadence)
# Copy to .env.local and set ONE provider key. Restart `npm run dev`.
# Without keys, the API returns deterministic mock cadence per brand name.

GROQ_API_KEY=

# Alternative to Groq (Generative Language API — NOT the same as GOOGLE_API_KEY for Translate/CSE):
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # Custom Search + Translate only — no usar como fallback LLM

# Google Cloud Translation API (POST /api/translate — dev + Vercel)
GOOGLE_TRANSLATE_API_KEY=

# Intel model overrides (optional — defaults in server/intelModels.js)
# GEMINI_FLASH_MODEL=gemini-2.0-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Horizon Scan live web search (POST /api/analytics/horizon-scan)
# https://serper.dev → API key → SERPAPI_KEY (Serper, not SerpApi.com)
# Required — without it Horizon Scan returns empty (no invented data).
SERPAPI_KEY=

# Campaign Analyst Pass 1 — Tavily (optional; Serper fallback when unset)
# https://tavily.com
TAVILY_API_KEY=

# ── Dashboard usuario — pasos 1–6 (npm run verify:apis) ─────────────────────
# Copiá este archivo a .env.local y reiniciá `npm run dev`.

# 6 · Supabase (cliente + APIs serverless)
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
# Server-only (no VITE_/SUPABASE_ prefix — never exposed to the browser)
FUTURA_SUPABASE_SERVICE_ROLE_KEY=
# Admin panel (/panel) + manual credit reset on /app/plans
VITE_ADMIN_EMAIL=
# Comma-separated test accounts — badge "test", excluded from paid MRR
# ADMIN_TEST_EMAILS=contact.fnota@gmail.com,xapplex65@gmail.com
# Monthly API $ budget alert (default 25 if unset)
# MANAGEMENT_API_BUDGET_USD=25
# Supabase Usage page snapshots for Storage & Quotas (fixed meters)
# Storage & Quotas Tabla A: run supabase_management_quotas.sql for editable meters.
# SUPABASE_USAGE_* used later for Tabla B (infra fixed).
# SUPABASE_USAGE_STORAGE_GB=0
# SUPABASE_USAGE_DISK_GB=2
# SUPABASE_USAGE_EGRESS_GB=6.277
# SUPABASE_USAGE_CACHED_EGRESS_GB=0
# SUPABASE_USAGE_MAU=1
# Beta-only agents (Sales Agent, Deep Researcher) — comma-separated emails
# AGENT_BETA_ALLOWLIST=contact.fnota@gmail.com
# Default: unset or not "true" = real billing UX (plan/credits from Supabase only, no auto-refill).
# Set to true only if you want legacy admin auto-Pro + auto-refill on login.
# VITE_ADMIN_AUTO_REFILL=true
# Alias Vite (opcional — mismo valor que arriba):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# 1 · Groq — campaign study, intel overview, admin scans
GROQ_API_KEY=
# 1b · Gemini — intel models + Groq fallback (optional if Groq is set)
# GEMINI_API_KEY=   # see top of file

# 2 · Serper (variable SERPAPI_KEY) — intel overview + admin Horizon/Campaign
SERPAPI_KEY=

# 3 · DataForSEO — PAA + search intent (campaign study)
# Base64 de "api_login:api_password" (sin prefijo Basic):
#   echo -n 'login:password' | base64
DATAFORSEO_LOGIN=
# Opcional legacy: login + password en texto plano (el código los codifica)
# DATAFORSEO_PASSWORD=

# 4 · Apify — social hype (campaign study)
APIFY_API_TOKEN=
# Actor recomendado para hype social (Twitter). Fallback: apify~google-search-scraper
# APIFY_SOCIAL_ACTOR_ID=apidojo~tweet-scraper

# 5 · OpenWeather — GET /api/weather/forecast
OPENWEATHER_API_KEY=
# WEATHER_DEFAULT_CITY=New York,US
# WEATHER_ALLOW_MOCK=1

# 7 · Event calendar — GET /api/events?from=&to=&country=
# PredictHQ (conferences, festivals, sports, expos): https://docs.predicthq.com/
PREDICTHQ_API_KEY=
# Legacy alias supported: CALENDAR_API_KEY or Calendar_Api
# Calendarific (holidays / observances, 500 free calls/mo): https://calendarific.com/
CALENDARIFIC_API_KEY=
# Legacy alias supported: Calendarific_Api
# EVENT_DEFAULT_COUNTRY=US

# Verificación: npm run verify:apis  |  GET http://localhost:5173/api/health/integrations
# SQL Supabase: ejecutar supabase_dashboard_apis.sql + supabase_billing.sql en SQL Editor
# Si plan=pro pero tokens_balance=10000 (1 crédito): supabase_fix_pro_ledger.sql

# ── Stripe billing (Pro $20/mo · $99/yr — live keys in .env.local only) ───────
STRIPE_SECRET_KEY=
# Alias accepted by the app if STRIPE_SECRET_KEY is unset:
# STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Production: leave verify checkout disabled (only "Upgrade to Pro" $20/mo on /app/plans).
# Optional dev-only: one-time live price to smoke-test Pro unlock (e.g. $0.50).
# STRIPE_PRICE_PRO_VERIFY_ONETIME=
# ENABLE_STRIPE_VERIFY_CHECKOUT=true
# Legacy aliases still supported: STRIPE_PRICE_PRO_TEST_ONETIME, ENABLE_STRIPE_TEST_CHECKOUT
APP_URL=https://www.futuranota.com
# Webhook endpoint (Stripe Dashboard): https://futuranota.com/api/billing/webhook
# Events: checkout.session.completed, invoice.paid, customer.subscription.updated, customer.subscription.deleted

# ── Resend — referral invite emails (POST /api/billing/referral-invite) ────────
RESEND_API_KEY=
# Verify domain in Resend, then e.g. Futura Nota <billing@futuranota.com>
REFERRAL_FROM_EMAIL=

# Groq reads business context from content/admin/detector-de-campanas.md
# Scan sources: /panel → Scan Sources (Supabase intel_scan_sources) or content/admin/scan-sources.json

# Horizon Scan curated-site search (optional, runs alongside Serper).
# Reuses GOOGLE_API_KEY above — just enable "Custom Search API" for that key's
# GCP project. Then create a Programmable Search Engine at
# https://programmablesearchengine.google.com and add the sites you want it to
# cover (Google retired "search the entire web" for new engines, so this is
# restricted to whatever sites you list there — not a general web search).
GOOGLE_CSE_CX=

# Tina CMS — https://app.tina.io → Project → Tokens (Content + Search)
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
TINA_SEARCH_TOKEN=
TINA_BRANCH=main
# Marketing site URL for Tina side-by-side preview (default http://localhost:5173)
TINA_PREVIEW_URL=http://localhost:5173


